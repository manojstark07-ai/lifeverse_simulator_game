  "events": [
    {
      "id": "ev_darkweb_invite",
      "chapter": 0,
      "title": "Invitation Link",
      "location": "dark_web_terminal",
      "summary": "A stranger offers access to a darker market.",
      "trigger": {
        "kind": "scheduled"
      },
      "start": "start",
      "nodes": {
        "start": {
          "speaker": "narrator",
          "text": "A private message arrives: an invite link, a countdown timer, and a promise that 'real money starts after the first favour.'",
          "choices": [
            {
              "id": "c_report",
              "label": "Screenshot it and report the account.",
              "next": "reported",
              "effects": [
                {
                  "type": "skill",
                  "key": "law",
                  "delta": 0.8
                },
                {
                  "type": "stat",
                  "key": "discipline",
                  "delta": 1
                },
                {
                  "type": "counter",
                  "key": "heat",
                  "delta": -1
                }
              ]
            },
            {
              "id": "c_enter",
              "label": "Enter the market and look around.",
              "next": "maze",
              "challenge": {
                "kind": "puzzle",
                "pool": "cyber_underworld",
                "count": 3,
                "passFraction": 0.67,
                "onPass": {
                  "next": "clean_exit",
                  "effects": [
                    {
                      "type": "skill",
                      "key": "programming",
                      "delta": 1
                    },
                    {
                      "type": "counter",
                      "key": "heat",
                      "delta": 1
                    }
                  ]
                },
                "onFail": {
                  "next": "tracked",
                  "effects": [
                    {
                      "type": "counter",
                      "key": "heat",
                      "delta": 3
                    },
                    {
                      "type": "stat",
                      "key": "wellbeing",
                      "delta": -3
                    }
                  ]
                }
              }
            },
            {
              "id": "c_close",
              "label": "Close the laptop.",
              "next": "closed"
            }
          ]
        },
        "reported": {
          "speaker": "narrator",
          "text": "The account disappears by morning. Maybe it was a scam. Maybe it was a sting. Either way, you sleep."
        },
        "maze": {
          "speaker": "narrator",
          "text": "The market is mostly lies wrapped in jargon. The danger is not that it looks scary; the danger is that some parts look ordinary."
        },
        "clean_exit": {
          "speaker": "narrator",
          "text": "You leave with more caution than curiosity. That counts as a win."
        },
        "tracked": {
          "speaker": "narrator",
          "text": "A warning email arrives from your bank about suspicious activity. Someone was watching the watcher."
        },
        "closed": {
          "speaker": "narrator",
          "text": "The timer hits zero without you. The room feels quieter after that."
        }
      },
      "repeatable": true
    },
    {
      "id": "ev_data_leak_market",
      "chapter": 0,
      "title": "The Leak",
      "location": "dark_web_terminal",
      "summary": "A stolen database is for sale.",
      "trigger": {
        "kind": "scheduled"
      },
      "start": "start",
      "nodes": {
        "start": {
          "speaker": "narrator",
          "text": "The seller previews names, phone numbers and addresses. Somewhere in that spreadsheet are real people who never agreed to become inventory.",
          "choices": [
            {
              "id": "c_tip",
              "label": "Tip off the company and cyber cell.",
              "next": "tip",
              "effects": [
                {
                  "type": "skill",
                  "key": "law",
                  "delta": 1
                },
                {
                  "type": "skill",
                  "key": "programming",
                  "delta": 0.5
                },
                {
                  "type": "flag",
                  "key": "cyber_tipster"
                },
                {
                  "type": "counter",
                  "key": "heat",
                  "delta": -2
                }
              ]
            },
            {
              "id": "c_buy",
              "label": "Buy the data and try to resell it.",
              "next": "resell",
              "cost": {
                "money": 6000
              },
              "challenge": {
                "kind": "puzzle",
                "pool": "cyber_underworld",
                "count": 3,
                "passFraction": 0.67,
                "onPass": {
                  "next": "profit",
                  "effects": [
                    {
                      "type": "money",
                      "amount": 25000,
                      "label": "Stolen data resale",
                      "category": "crime"
                    },
                    {
                      "type": "counter",
                      "key": "crimes",
                      "delta": 1
                    },
                    {
                      "type": "counter",
                      "key": "heat",
                      "delta": 3
                    },
                    {
                      "type": "flag",
                      "key": "crime_any"
                    },
                    {
                      "type": "flag",
                      "key": "data_broker"
                    }
                  ]
                },
                "onFail": {
                  "next": "sting",
                  "effects": [
                    {
                      "type": "counter",
                      "key": "heat",
                      "delta": 4
                    },
                    {
                      "type": "flag",
                      "key": "police_record"
                    },
                    {
                      "type": "schedule",
                      "event": "ev_arrest_petty",
                      "inDays": 0
                    }
                  ]
                }
              }
            },
            {
              "id": "c_ignore",
              "label": "Back away.",
              "next": "ignore"
            }
          ]
        },
        "tip": {
          "speaker": "narrator",
          "text": "A month later the breach makes the news with fewer victims than it could have had."
        },
        "resell": {
          "speaker": "narrator",
          "text": "Every buyer sounds like an undercover officer when your own name is now in a chat log."
        },
        "profit": {
          "speaker": "narrator",
          "text": "Money lands in your wallet. So does a new kind of paranoia."
        },
        "sting": {
          "speaker": "narrator",
          "text": "The buyer asks one question too many. Then the screen goes quiet and someone knocks on your door."
        },
        "ignore": {
          "speaker": "narrator",
          "text": "You close the tab. For once, curiosity loses."
        }
      },
      "repeatable": true
    },
    {
      "id": "ev_ransomware_offer",
      "chapter": 0,
      "title": "The Ransom Crew",
      "location": "dark_web_terminal",
      "summary": "A cybercrime crew offers a payout.",
      "trigger": {
        "kind": "scheduled"
      },
      "start": "start",
      "nodes": {
        "start": {
          "speaker": "narrator",
          "text": "They do not ask you to write code. They ask you to choose victims, handle panic, and pretend there is a clean side to dirty money.",
          "choices": [
            {
              "id": "c_refuse",
              "label": "Refuse and cut contact.",
              "next": "refused",
              "effects": [
                {
                  "type": "stat",
                  "key": "discipline",
                  "delta": 2
                }
              ]
            },
            {
              "id": "c_undercover",
              "label": "Play along just long enough to gather evidence.",
              "next": "undercover",
              "challenge": {
                "kind": "puzzle",
                "pool": "cyber_underworld",
                "count": 4,
                "passFraction": 0.75,
                "onPass": {
                  "next": "evidence",
                  "effects": [
                    {
                      "type": "skill",
                      "key": "law",
                      "delta": 1.5
                    },
                    {
                      "type": "skill",
                      "key": "programming",
                      "delta": 1
                    },
                    {
                      "type": "counter",
                      "key": "heat",
                      "delta": -3
                    },
                    {
                      "type": "flag",
                      "key": "cyber_tipster"
                    }
                  ]
                },
                "onFail": {
                  "next": "exposed",
                  "effects": [
                    {
                      "type": "stat",
                      "key": "wellbeing",
                      "delta": -5
                    },
                    {
                      "type": "counter",
                      "key": "heat",
                      "delta": 2
                    }
                  ]
                }
              }
            },
            {
              "id": "c_join",
              "label": "Join the crew for one payout.",
              "next": "joined",
              "challenge": {
                "kind": "puzzle",
                "pool": "cyber_underworld",
                "count": 4,
                "passFraction": 0.5,
                "onPass": {
                  "next": "paid",
                  "effects": [
                    {
                      "type": "money",
                      "amount": 120000,
                      "label": "Ransomware cut",
                      "category": "crime"
                    },
                    {
                      "type": "counter",
                      "key": "crimes",
                      "delta": 1
                    },
                    {
                      "type": "counter",
                      "key": "heat",
                      "delta": 5
                    },
                    {
                      "type": "flag",
                      "key": "crime_any"
                    },
                    {
                      "type": "flag",
                      "key": "cybercriminal"
                    }
                  ]
                },
                "onFail": {
                  "next": "raid",
                  "effects": [
                    {
                      "type": "flag",
                      "key": "police_record"
                    },
                    {
                      "type": "counter",
                      "key": "heat",
                      "delta": 6
                    },
                    {
                      "type": "schedule",
                      "event": "ev_arrest_petty",
                      "inDays": 0
                    }
                  ]
                }
              }
            }
          ]
        },
        "refused": {
          "speaker": "narrator",
          "text": "They call you soft. You call it survival."
        },
        "undercover": {
          "speaker": "narrator",
          "text": "Every message you save feels like standing closer to a live wire."
        },
        "evidence": {
          "speaker": "narrator",
          "text": "The cyber cell takes the evidence seriously. Nobody thanks you loudly, which is probably safer."
        },
        "exposed": {
          "speaker": "narrator",
          "text": "The crew realises you were collecting evidence. Your phone vibrates all night with threats."
        },
        "joined": {
          "speaker": "narrator",
          "text": "The victim's panic arrives in screenshots. It is easy to forget a crime has a face until it does."
        },
        "paid": {
          "speaker": "narrator",
          "text": "The payout clears. The heat does not."
        },
        "raid": {
          "speaker": "narrator",
          "text": "A group chat becomes a charge sheet. The crew vanishes; your devices do not."
        }
      },
      "repeatable": true
    },
    {
      "id": "ev_bio_sample_courier",
      "chapter": 0,
      "title": "Cold Box",
      "location": "bio_backroom",
      "summary": "A biomedical courier job raises alarms.",
      "trigger": {
        "kind": "scheduled"
      },
      "start": "start",
      "nodes": {
        "start": {
          "speaker": "narrator",
          "text": "The box is cold enough to fog in the heat. The clinic owner says not to ask what is inside. That is an answer.",
          "choices": [
            {
              "id": "c_return",
              "label": "Return it and walk away.",
              "next": "returned",
              "effects": [
                {
                  "type": "stat",
                  "key": "discipline",
                  "delta": 1
                },
                {
                  "type": "counter",
                  "key": "heat",
                  "delta": -1
                }
              ]
            },
            {
              "id": "c_deliver",
              "label": "Deliver the box.",
              "next": "delivery",
              "challenge": {
                "kind": "puzzle",
                "pool": "bio_underworld",
                "count": 3,
                "passFraction": 0.67,
                "onPass": {
                  "next": "paid",
                  "effects": [
                    {
                      "type": "money",
                      "amount": 18000,
                      "label": "Backroom courier payment",
                      "category": "crime"
                    },
                    {
                      "type": "counter",
                      "key": "crimes",
                      "delta": 1
                    },
                    {
                      "type": "counter",
                      "key": "heat",
                      "delta": 2
                    },
                    {
                      "type": "flag",
                      "key": "bio_black_market"
                    },
                    {
                      "type": "flag",
                      "key": "crime_any"
                    }
                  ]
                },
                "onFail": {
                  "next": "checkpoint",
                  "effects": [
                    {
                      "type": "counter",
                      "key": "heat",
                      "delta": 4
                    },
                    {
                      "type": "flag",
                      "key": "police_record"
                    }
                  ]
                }
              }
            },
            {
              "id": "c_hospital",
              "label": "Take it to a real hospital and explain.",
              "next": "hospital",
              "effects": [
                {
                  "type": "skill",
                  "key": "medicine",
                  "delta": 0.8
                },
                {
                  "type": "skill",
                  "key": "law",
                  "delta": 0.6
                },
                {
                  "type": "flag",
                  "key": "bio_whistleblower"
                }
              ]
            }
          ]
        },
        "returned": {
          "speaker": "narrator",
          "text": "The owner laughs at you, but locks the box away fast."
        },
        "delivery": {
          "speaker": "narrator",
          "text": "Every speed breaker sounds like the box cracking."
        },
        "paid": {
          "speaker": "narrator",
          "text": "The money is clean. The route was not."
        },
        "checkpoint": {
          "speaker": "narrator",
          "text": "A checkpoint officer asks for papers. The box has none."
        },
        "hospital": {
          "speaker": "narrator",
          "text": "The hospital security desk becomes a police desk within twenty minutes."
        }
      },
      "repeatable": true
    },
    {
      "id": "ev_bio_trial_fraud",
      "chapter": 0,
      "title": "Trial Papers",
      "location": "bio_backroom",
      "summary": "Fake clinical trial documents put patients at risk.",
      "trigger": {
        "kind": "scheduled"
      },
      "start": "start",
      "nodes": {
        "start": {
          "speaker": "narrator",
          "text": "A recruiter is selling trial forms with forged stamps. The patients think the papers mean hope. The clinic thinks they mean profit.",
          "choices": [
            {
              "id": "c_expose",
              "label": "Expose the fraud.",
              "next": "exposed",
              "challenge": {
                "kind": "puzzle",
                "pool": "bio_underworld",
                "count": 4,
                "passFraction": 0.75,
                "onPass": {
                  "next": "case",
                  "effects": [
                    {
                      "type": "skill",
                      "key": "medicine",
                      "delta": 1.5
                    },
                    {
                      "type": "skill",
                      "key": "law",
                      "delta": 1
                    },
                    {
                      "type": "flag",
                      "key": "bio_whistleblower"
                    }
                  ]
                },
                "onFail": {
                  "next": "messy",
                  "effects": [
                    {
                      "type": "stat",
                      "key": "wellbeing",
                      "delta": -3
                    }
                  ]
                }
              }
            },
            {
              "id": "c_forge",
              "label": "Help clean up the forged paperwork.",
              "next": "forge",
              "effects": [
                {
                  "type": "money",
                  "amount": 35000,
                  "label": "Forged trial papers",
                  "category": "crime"
                },
                {
                  "type": "counter",
                  "key": "crimes",
                  "delta": 1
                },
                {
                  "type": "counter",
                  "key": "heat",
                  "delta": 4
                },
                {
                  "type": "flag",
                  "key": "bio_black_market"
                },
                {
                  "type": "flag",
                  "key": "crime_any"
                }
              ]
            },
            {
              "id": "c_leave",
              "label": "Leave and warn one patient quietly.",
              "next": "warned",
              "effects": [
                {
                  "type": "stat",
                  "key": "wellbeing",
                  "delta": 1
                }
              ]
            }
          ]
        },
        "exposed": {
          "speaker": "narrator",
          "text": "You sort forms, dates and contradictions until the pattern becomes impossible to ignore."
        },
        "case": {
          "speaker": "narrator",
          "text": "The case reaches a regulator. The clinic shuts for a week; the recruiter disappears."
        },
        "messy": {
          "speaker": "narrator",
          "text": "The documents are worse than you thought. You cannot prove enough, but you know enough to feel sick."
        },
        "forge": {
          "speaker": "narrator",
          "text": "Your edits make the papers look cleaner. That is the dirtiest part."
        },
        "warned": {
          "speaker": "narrator",
          "text": "One person walks away. It is not enough, but it is not nothing."
        }
      },
      "repeatable": true
    },
    {

              "next": "crew",
              "effects": [
                {
                  "type": "counter",
                  "key": "heat",
                  "delta": 4
                },
                {
                  "type": "counter",
                  "key": "crimes",
                  "delta": 1
                },
                {
                  "type": "flag",
                  "key": "crime_any"
                },
                {
                  "type": "stat",
                  "key": "discipline",
                  "delta": -2
                }
              ]
            }
          ]

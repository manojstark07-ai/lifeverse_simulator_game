  "events": [
    {
      "id": "ev_c_comments",
      "chapter": 0,
      "title": "The Comment Section",
      "location": "home",
      "summary": "Your first hater shows up.",
      "trigger": {
        "kind": "auto",
        "when": {
          "type": "all",
          "conditions": [
            {
              "type": "creator"
            },
            {
              "type": "creator",
              "field": "subscribers",
              "op": ">=",
              "value": 300
            }
          ]
        },
        "priority": 26
      },
      "start": "start",
      "nodes": {
        "start": {
          "speaker": "narrator",
          "text": "Three hundred subscribers. Then a comment: 'cringe content, quit while you can.' It has twelve likes. You read it nine times.",
          "choices": [
            {
              "id": "c_joke",
              "label": "Reply with a joke — and pin it.",
              "next": "joke",
              "effects": [
                {
                  "type": "stat",
                  "key": "communication",
                  "delta": 1
                },
                {
                  "type": "creator",
                  "subsPercent": 2
                }
              ]
            },
            {
              "id": "c_block",
              "label": "Delete and block. Move on.",
              "next": "block",
              "effects": [
                {
                  "type": "stat",
                  "key": "wellbeing",
                  "delta": 1
                }
              ]
            },
            {
              "id": "c_argue",
              "label": "Write a long, angry reply.",
              "next": "argue",
              "effects": [
                {
                  "type": "stat",
                  "key": "wellbeing",
                  "delta": -3
                },
                {
                  "type": "creator",
                  "subsPercent": 1
                }
              ]
            },
            {
              "id": "c_break",
              "label": "Stop reading comments for a week.",
              "next": "rest",
              "effects": [
                {
                  "type": "stat",
                  "key": "wellbeing",
                  "delta": 2
                }
              ]
            }
          ]
        },
        "joke": {
          "speaker": "narrator",
          "text": "Your reply gets more likes than the insult. Your regulars start defending you. Turns out a sense of humour is content too."
        },
        "block": {
          "speaker": "narrator",
          "text": "Gone. The other ninety-nine comments were kind. You decide to read those twice instead."
        },
        "argue": {
          "speaker": "narrator",
          "text": "Your reply gets screenshotted. A few people laugh at you; a few more subscribe for the drama. You feel worse than the views suggest."
        },
        "rest": {
          "speaker": "narrator",
          "text": "A week without comments. You film better when you're not editing in your head for strangers."
        }
      }
    },
    {
      "id": "ev_c_collab",
      "chapter": 0,
      "title": "Collab Offer",
      "location": "cafe",
      "summary": "A bigger creator wants to work with you.",
      "trigger": {
        "kind": "auto",
        "when": {
          "type": "all",
          "conditions": [
            {
              "type": "creator"
            },
            {
              "type": "creator",
              "field": "subscribers",
              "op": ">=",
              "value": 5000
            }
          ]
        },
        "priority": 27
      },
      "start": "start",
      "nodes": {
        "start": {
          "speaker": "narrator",
          "text": "Rhea, who runs a channel ten times your size, DMs you: 'Love your stuff. Collab? I'm in Bengaluru next weekend.'",
          "choices": [
            {
              "id": "c_go",
              "label": "Go — travel and stay cost ₹3,000.",
              "next": "go",
              "effects": [
                {
                  "type": "creator",
                  "subsPercent": 15
                },
                {
                  "type": "stat",
                  "key": "communication",
                  "delta": 1.5
                },
                {
                  "type": "stat",
                  "key": "wellbeing",
                  "delta": 3
                }
              ],
              "cost": {
                "money": 3000,
                "energy": 10
              }
            },
            {
              "id": "c_remote",
              "label": "Suggest a remote collab instead.",
              "next": "remote",
              "effects": [
                {
                  "type": "creator",
                  "subsPercent": 6
                },
                {
                  "type": "stat",
                  "key": "communication",
                  "delta": 0.5
                }
              ]
            },
            {
              "id": "c_no",
              "label": "Politely decline — you're not ready.",
              "next": "no",
              "effects": [
                {
                  "type": "stat",
                  "key": "wellbeing",
                  "delta": -1
                }
              ]
            }
          ]
        },
        "go": {
          "speaker": "narrator",
          "text": "Two days of filming, one disastrous street-food challenge, and a video that does numbers on both channels. Rhea says you're a natural. You almost believe her."
        },
        "remote": {
          "speaker": "narrator",
          "text": "The split-screen collab is fine. Not magic, but fine. A few hundred of Rhea's viewers find you."
        },
        "no": {
          "speaker": "narrator",
          "text": "Rhea says 'next time!' You wonder if there will be one."
        }
      }
    },
    {
      "id": "ev_c_sponsor",
      "chapter": 0,
      "title": "Easy Money",
      "location": "home",
      "summary": "A sponsor with deep pockets and a dodgy product.",
      "trigger": {
        "kind": "auto",
        "when": {
          "type": "all",
          "conditions": [
            {
              "type": "creator"
            },
            {
              "type": "creator",
              "field": "subscribers",
              "op": ">=",
              "value": 20000
            }
          ]
        },
        "priority": 28
      },
      "start": "start",
      "nodes": {
        "start": {
          "speaker": "narrator",
          "text": "An agency emails: ₹1,50,000 for a 60-second promo of 'LuckyPlay', a fantasy-betting app. 'Just say it's fun and link it below.' Half your audience is under twenty.",
          "choices": [
            {
              "id": "c_take",
              "label": "Take the money.",
              "next": "take",
              "effects": [
                {
                  "type": "money",
                  "amount": 150000,
                  "label": "LuckyPlay sponsorship",
                  "category": "creator"
                },
                {
                  "type": "flag",
                  "key": "shady_promo"
                },
                {
                  "type": "delayed",
                  "inDays": 60,
                  "note": "The LuckyPlay backlash",
                  "effects": [
                    {
                      "type": "creator",
                      "subsPercent": -12
                    },
                    {
                      "type": "stat",
                      "key": "wellbeing",
                      "delta": -4
                    }
                  ]
                }
              ],
              "hint": "Fast money. Your audience may not forgive it."
            },
            {
              "id": "c_refuse",
              "label": "Refuse and tell your audience why.",
              "next": "refuse",
              "effects": [
                {
                  "type": "flag",
                  "key": "principled_creator"
                },
                {
                  "type": "creator",
                  "subsPercent": 4
                },
                {
                  "type": "stat",
                  "key": "wellbeing",
                  "delta": 2
                }
              ]
            },
            {
              "id": "c_ignore",
              "label": "Ignore the email.",
              "next": "ignore",
              "effects": []
            }
          ]
        },
        "take": {
          "speaker": "narrator",
          "text": "The money lands in two days. The comments take a little longer: 'sold out', 'my brother lost ₹20K on this app'. You tell yourself everyone does it."
        },
        "refuse": {
          "speaker": "narrator",
          "text": "Your 'why I said no' video becomes your most-shared upload. A legitimate brand reaches out the next week, citing it."
        },
        "ignore": {
          "speaker": "narrator",
          "text": "The agency sends three follow-ups, then gives up. So does the guilt."
        }
      }
    },
    {
      "id": "ev_c_controversy",
      "chapter": 0,
      "title": "Out of Context",
      "location": "home",
      "summary": "An old clip, cut badly, goes around.",
      "trigger": {
        "kind": "random",
        "when": {
          "type": "all",
          "conditions": [
            {
              "type": "creator"
            },
            {
              "type": "creator",
              "field": "subscribers",
              "op": ">=",
              "value": 2000
            }
          ]
        },
        "chancePerMonth": 0.06
      },
      "start": "start",
      "nodes": {
        "start": {
          "speaker": "narrator",
          "text": "Someone has clipped eight seconds of an old video so you sound cruel. It's trending. Your notifications are a wall of red.",
          "choices": [
            {
              "id": "c_sorry",
              "label": "Post a sincere apology anyway.",
              "next": "sorry",
              "effects": [
                {
                  "type": "creator",
                  "subsPercent": -3
                },
                {
                  "type": "stat",
                  "key": "wellbeing",
                  "delta": -2
                }
              ]
            },
            {
              "id": "c_explain",
              "label": "Post the full clip and explain calmly.",
              "next": "explained",
              "effects": [
                {
                  "type": "roll",
                  "key": "controversy_cleared",
                  "chance": 0.6
                }
              ],
              "routes": [
                {
                  "when": {
                    "type": "flag",
                    "key": "controversy_cleared"
                  },
                  "next": "cleared"
                }
              ]
            },
            {
              "id": "c_silent",
              "label": "Go silent for a month.",
              "next": "silent",
              "effects": [
                {
                  "type": "creator",
                  "subsPercent": -6
                },
                {
                  "type": "stat",
                  "key": "wellbeing",
                  "delta": 1
                }
              ]
            },
            {
              "id": "c_double",
              "label": "Double down — attention is attention.",
              "next": "double",
              "effects": [
                {
                  "type": "creator",
                  "subsPercent": 5
                },
                {
                  "type": "delayed",
                  "inDays": 45,
                  "note": "The controversy catches up",
                  "effects": [
                    {
                      "type": "creator",
                      "subsPercent": -15
                    },
                    {
                      "type": "stat",
                      "key": "wellbeing",
                      "delta": -5
                    }
                  ]
                }
              ]
            }
          ]
        },
        "sorry": {
          "speaker": "narrator",
          "text": "The apology is gracious and some people still don't accept it. Most of your regulars do."
        },
        "explained": {
          "speaker": "narrator",
          "text": "The full clip helps a little, but the internet has moved on to being angry about something else. You lose a few subscribers and some sleep.",
          "onEnter": [
            {
              "type": "creator",
              "subsPercent": -4
            },
            {
              "type": "stat",
              "key": "wellbeing",
              "delta": -2
            }
          ]
        },
        "cleared": {
          "speaker": "narrator",
          "text": "The full clip goes around faster than the edit did. 'Okay, that's a hit piece,' says a big account. You end the week with more subscribers than you started.",
          "onEnter": [
            {
              "type": "creator",
              "subsPercent": 5
            },
            {
              "type": "stat",
              "key": "communication",
              "delta": 1
            }
          ]
        },
        "silent": {
          "speaker": "narrator",
          "text": "A month away. When you return, the people who stayed are the ones who matter."
        },
        "double": {
          "speaker": "narrator",
          "text": "The views spike. So does the hate. For a few days it feels like winning."
        }
      }
    },
    {
      "id": "ev_c_burnout",
      "chapter": 0,
      "title": "Running on Empty",
      "location": "home",
      "summary": "Full-time creating is grinding you down.",
      "trigger": {
        "kind": "auto",
        "when": {
          "type": "all",
          "conditions": [
            {
              "type": "creator",
              "field": "fullTime",
              "value": true
            },
            {
              "type": "stat",
              "key": "wellbeing",
              "op": "<",
              "value": 35
            }
          ]
        },
        "priority": 45
      },
      "start": "start",
      "nodes": {
        "start": {
          "speaker": "narrator",
          "text": "Six uploads a month, every month. You can't remember the last time you did something without thinking 'this could be content'.",
          "choices": [
            {
              "id": "c_break",
              "label": "Announce a one-month break.",
              "next": "break",
              "effects": [
                {
                  "type": "creator",
                  "subsPercent": -5
                },
                {
                  "type": "stat",
                  "key": "wellbeing",
                  "delta": 12
                },
                {
                  "type": "stat",
                  "key": "energy",
                  "delta": 20
                }
              ]
            },
            {
              "id": "c_editor",
              "label": "Hire a freelance editor (₹15,000).",
              "next": "editor",
              "effects": [
                {
                  "type": "stat",
                  "key": "wellbeing",
                  "delta": 6
                },
                {
                  "type": "stat",
                  "key": "energy",
                  "delta": 10
                }
              ],
              "cost": {
                "money": 15000
              }
            },
            {
              "id": "c_push",
              "label": "Push through.",
              "next": "push",
              "effects": [
                {
                  "type": "stat",
                  "key": "wellbeing",
                  "delta": -5
                },
                {
                  "type": "stat",
                  "key": "health",
                  "delta": -3
                }
              ]
            }
          ]
        },
        "break": {
          "speaker": "narrator",
          "text": "You post a short, honest video about burnout. It gets more kind comments than anything you've made. The break helps more than the views ever did."
        },
        "editor": {
          "speaker": "narrator",
          "text": "Handing over the timeline feels like giving away a child. Then you sleep eight hours, and it feels great."
        },
        "push": {
          "speaker": "narrator",
          "text": "You keep going. The videos get a little worse, and so do you."
        }
      }
    },
    {
      "id": "ev_c_silver",
      "chapter": 0,
      "title": "The Silver Plaque",
      "location": "home",
      "summary": "One hundred thousand people chose to follow you.",
      "trigger": {
        "kind": "auto",
        "when": {
          "type": "flag",

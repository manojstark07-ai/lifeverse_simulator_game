              "weight": 2
            }
          ],
          "variants": [
            {
              "when": {
                "type": "flag",
                "key": "principled_creator"
              },
              "text": "'Your cousin showed me the video where you refused that betting app,' she says. 'That one I watched three times.'"
            }
          ],
          "choices": [
            {
              "id": "c_party",
              "label": "Throw a party for everyone who helped (₹20,000).",
              "next": "party",
              "effects": [
                {
                  "type": "relationship",
                  "npc": "kavya",
                  "affinity": 4,
                  "trust": 2
                },
                {
                  "type": "stat",
                  "key": "wellbeing",
                  "delta": 6
                }
              ],
              "cost": {
                "money": 20000
              }
            },
            {
              "id": "c_frame",
              "label": "Hang it in the living room, quietly.",
              "next": "frame",
              "effects": [
                {
                  "type": "stat",
                  "key": "wellbeing",
                  "delta": 4
                }
              ]
            }
          ]
        },
        "party": {
          "speaker": "narrator",
          "text": "Kavya gives a speech that's mostly insults and ends with her crying. The best night in years."
        },
        "frame": {
          "speaker": "narrator",
          "text": "It hangs next to your school certificates. Amma dusts it every morning."
        }
      }
    },
    {
